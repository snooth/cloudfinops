# Cloud FinOps Portal — Environment Configuration
# Copy this file to .env and adjust values

# Server
PORT=4000
HOST=0.0.0.0

# Public URL base path (leave empty for root, e.g. https://iamfinops.com.au/)
# For corporate mirror under Firmgate: BASE_PATH=/finops → https://firmgate.io/finops/
# Must match the client build: VITE_BASE_PATH=/finops npm run build
BASE_PATH=
VITE_BASE_PATH=

# Azure Retail Pricing (public API — no credentials required)
# Default region — can also be changed in Configuration UI
# Options: australiaeast (AU East), australiacentral (AU Central), australiacentral2 (AU Central 2)
AZURE_REGION=australiaeast
AZURE_CURRENCY=AUD

# Azure Retail Pricing — offline by default (uses server/data/azure-pricing-snapshot.json)
# Set AZURE_PRICING_ONLINE=true only when internet is available to refresh live rates
AZURE_PRICING_ONLINE=false

# Azure Cost Management API (optional — for actual spend data)
# Requires a service principal with Cost Management Reader role
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Alternative: use `az login` and leave service principal blank.
# DefaultAzureCredential will use your Azure CLI session.
